{
  "name": "@jackyzhou0227/dsh-mobile-control",
  "version": "0.2.0",
  "description": "通过 DSH 会话操作 Android、HarmonyOS 和 iOS 设备，并在右侧栏实时投屏",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackyZhou0227/dsh-mobile-control.git",
    "directory": "plugin"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/**",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/**",
    "test/**",
    "vendor/**"
  ],
  "dsh": {
    "bundle": {
      "patch": ["./cordis.patch.yml", "./presets/mobile.patch.yml"]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "scripts": {
    "fetch-vendor": "node scripts/fetch-vendor.mjs",
    "test": "node test/android.mjs"
  },
  "license": "MIT"
}
